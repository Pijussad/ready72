# Ready72 environment variables
# Never commit a real key. Flutter reads these through --dart-define,
# for example:
#   flutter run --dart-define=DEEPSEEK_API_KEY=sk-...
#
# Without a key, Ready72 uses its deterministic on-device needs parser and
# the whole demo works offline.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Replay a recorded response instead of calling the network.
DEEPSEEK_REPLAY=false
